# Normalise line endings for everything Git treats as text.
* text=auto eol=lf

*.gd          text eol=lf
*.tscn        text eol=lf
*.tres        text eol=lf
*.godot       text eol=lf
*.cfg         text eol=lf
*.import      text eol=lf
*.uid         text eol=lf
*.svg         text eol=lf

# Build output and binary assets — never diff or merge these.
*.wasm        binary
*.pck         binary
*.wav         binary
*.png         binary
*.blend       binary
build/web/**  linguist-generated=true

# Asset packs live in Git LFS. Keep this below the `* text=auto` rule above:
# attributes are last-match-wins, so listing it first would let the catch-all
# re-enable text conversion on the archives and corrupt them.
*.zip filter=lfs diff=lfs merge=lfs -text
