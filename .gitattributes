# Normalise line endings for everything Git treats as text.
* text=auto eol=lf

*.gd          text eol=lf
*.tscn        text eol=lf
*.tres        text eol=lf
*.godot       text eol=lf
*.cfg         text eol=lf
*.import      text eol=lf
*.uid         text eol=lf
*.svg         text eol=lf

# Build output and binary assets — never diff or merge these.
*.wasm        binary
*.pck         binary
*.wav         binary
*.png         binary
build/web/**  linguist-generated=true
